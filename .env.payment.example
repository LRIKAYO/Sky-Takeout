# Day08 支付配置示例：使用自己的商户材料，合并进本机 .env.local，不要覆盖原配置。
# 沿用本工程 SDK 0.4.8 的平台证书方式；本文件没有真实凭据。
SKY_WECHAT_MCHID=
SKY_WECHAT_MCH_SERIAL_NO=
SKY_WECHAT_PRIVATE_KEY_FILE_PATH=C:/your-own-cert/apiclient_key.pem
SKY_WECHAT_API_V3_KEY=
SKY_WECHAT_PAY_CERT_FILE_PATH=C:/your-own-cert/wechatpay-platform.pem
SKY_WECHAT_NOTIFY_URL=https://your-own-domain/notify/paySuccess
# 退款业务尚未导入，只有实际实现对应入口后再填写：
SKY_WECHAT_REFUND_NOTIFY_URL=
